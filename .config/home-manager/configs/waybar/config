{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    // "height": 20, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "sway/window"
    //, "custom/media"
    ],
    "modules-center": ["clock", "custom/weather", "sway/mode"],
    "modules-right": ["idle_inhibitor", "custom/notifications", "pulseaudio", "backlight", "network",
    //"custom/vpn",
    "cpu", "memory", "temperature", "battery",
    "custom/github", "tray", "sway/language", "custom/lockkeys", "custom/power"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "Terminal ",
            "3": "",
            "4": "Code ",
            "5": "",
            "6": "",
            // "6:docs": "",
            "urgent": "",
            "focused": "",
            "default": ""
            // "default": ""
        }
    },
    "sway/mode": {
        "format": " {}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        // "spacing": 10
    },
    "clock": {
        // "timezone": "Europe/Athens",
        "locale": "C",
        "interval": 20,
        "tooltip-format": "<tt>{calendar}</tt>",
        //"format": "{:%H:%M:%S}C",
        "format": "{:%Y-%m-%d | %H:%M}"
        //"on-click": "gnome-calendar"
        //"format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": true,
        "on-click": "foot btop"
    },
    "memory": {
        //"format": "{percentage}% ",
        "format": "",
        "format-warning": "{percentage}% ",
        "format-critical": "{percentage}% ",
        "tooltip-format": "RAM: {used:0.1f}G/{total:0.1f}G Swap: {swapUsed:0.1f}G/{swapTotal:0.1f}G",
        "states": {"warning": 80, "critical": 95},
        "on-click": "foot btop"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 60,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{icon}",
        "format-icons": ["", "", ""],
        "on-click": "foot btop"
    },
    "disk": {
        "interval": 30,
        "format": "{path}: {percentage_used}%",
        "format-alt": "{used}/{total}",
        "path": "/"
    },
    "disk#home": {
        "interval": 30,
        "format": "{path}: {percentage_used}%",
        "format-alt": "{used}/{total}",
        "path": "/home"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", ""]
        //"on-scroll-up": "./brightness-up.sh",
        //"on-scroll-down": "./brightness-down.sh"
    },
    "battery": {
        //"bat": "BAT0",
        "states": {
            "full": 100,
            "good": 95,
            "warning": 30,
            "critical": 15,
            "fatal": 5
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}%  🡱",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        //"format-good": "", // An empty format will hide the module
        "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "on-click": "nm-connection-editor",
        "format-alt-click": "click-right",
        "format-ethernet": "{ifname} ",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "format-wifi": "{essid:4} {icon}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ifname}: {ipaddr}/{cidr}",
        "format-linked": "{ifname}: (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "format-icons": ["", "", ""]
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/language": {
        "format": "{shortDescription}",
        "tooltip-format": "{long} {variant}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
        "on-click-right": "gnome-control-center region"
    },
    "custom/vpn": {
        "format": "VPN ",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "exec": "echo '{\"class\": \"connected\"}'",
        "exec-if": "test -d /proc/sys/net/ipv4/conf/tun0",
        "return-type": "json",
        "interval": 5
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl -- set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
//        "exec-if": "pgrep spotify",
        "exec": "$XDG_CONFIG_HOME/waybar/mediaplayer.sh 2> /dev/null" // Script in resources folder
    },
    "custom/weather": {
        //"exec": "curl 'https://wttr.in/?format=1'",
        //"format": "{}",
        "tooltip": true,
        "interval": 3600,
        "exec": "$XDG_CONFIG_HOME/waybar/waybar-wttr.py",
        "return-type": "json",
        "on-click": "foot sh -c 'curl wttr.in; read'",
        "max-length": 10
    },
    "custom/github": {
        "format": "{} ",
        "return-type": "json",
        "interval": 60,
        "exec": "$XDG_CONFIG_HOME/waybar/github.sh",
        "on-click": "xdg-open https://github.com/notifications"
    },
    "custom/notifications": {
        "format": "{}",
        "exec": "$XDG_CONFIG_HOME/waybar/notifications.sh",
        "return-type": "json",
        "signal": 8,
        "exec-on-event": false,
        "on-click": "$XDG_CONFIG_HOME/waybar/notifications.sh toggle",
        "on-click-right": "makoctl dismiss -a",
        "tooltip": true
    },
    "custom/power": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    },
    "custom/lockkeys": {
        "format": "{}",
        "exec": "$XDG_CONFIG_HOME/waybar/lockkeys.sh",
        "return-type": "json",
        "interval": 1
    }
}
