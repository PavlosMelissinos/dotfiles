font=DejaVu Sans 9
# anchor=bottom-right
width=350
padding=10
margin=10
border-size=5
default-timeout=10000

# Only for desktop, ignored when no such output exists
#output=DP-4

background-color=#231f20
# background-color=#000000
border-color=#009ddc
text-color=#d9d8d8

[urgency=high]
border-color=#ee2e24
ignore-timeout=1

# Toggle with `makoctl mode -t do-not-disturb` (bound to $mod+Shift+n).
# invisible=1 keeps notifications from being drawn, e.g. while screen sharing.
[mode=do-not-disturb]
invisible=1
